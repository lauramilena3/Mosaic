def inputRefSeqMapping(wildcards):
	if not SAMPLES:
		raise ValueError("RefSeq mapping requires paired-end samples in input_dir.")
	negative_control=str(config.get("negative_control", "")).strip()
	if negative_control and negative_control not in SAMPLES:
		raise ValueError(f"negative_control '{negative_control}' must match a paired-end sample in input_dir: {SAMPLES}")
	if not str(config.get("RefSeqViral_db", "")).strip():
		raise ValueError("Set RefSeqViral_db to the viral nucleotide FASTA for RefSeq mapping.")
	inputs=expand(dirs_dict["MAPPING_DIR"] + "/REFSEQ_VIRAL/bowtie2_flagstats_filtered_RefSeqViral_{sample}.tot.txt", sample=SAMPLES)
	inputs.append(dirs_dict["MAPPING_DIR"] + "/REFSEQ_VIRAL/RefSeqViral_RPKM_normalised_tot.txt")
	inputs.append(dirs_dict["MAPPING_DIR"] + "/REFSEQ_VIRAL/RefSeqViral_detection_long_tot.tsv")
	inputs.append(dirs_dict["NOTEBOOKS_DIR"] + "/07_Normalise_RefSeqViral.tot.html")
	inputs.append(dirs_dict["NOTEBOOKS_DIR"] + "/07_RefSeq_detection.py.html")
	return inputs

rule map_to_RefSeq:
	input:
		inputRefSeqMapping,

rule map_to_all_assembled:
	input:
		input_all_assembled_mapping,

