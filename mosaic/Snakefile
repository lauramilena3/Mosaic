def annotation_fasta_path(sequence):
	if sequence == "host_enriched_regions.tot":
		return dirs_dict["HOST_DIR"] + "/enriched_regions/host_enriched_regions.tot.fasta"
	if sequence == "phage_isolates_cluster_representatives.tot":
		return PHAGE_ISOLATES_CLUSTER_PREFIX + ".tot.fasta"
	if sequence.startswith("host_viral_"):
		return dirs_dict["HOST_DIR"] + "/prophages/" + sequence.removeprefix("host_viral_") + "_bacphlip_input.fasta"
	if sequence in config.get("annotation_fastas", {}):
		return config["annotation_fastas"][sequence]
	if sequence == ALL_ASSEMBLED_TOP_NAME + ".tot":
		return ALL_ASSEMBLED_TOP_PREFIX + ".fasta"
	return dirs_dict["vOUT_DIR"] + "/" + sequence + ".fasta"

